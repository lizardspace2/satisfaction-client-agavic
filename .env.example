# Configuration Supabase — https://supabase.com/dashboard
# Copiez ce fichier en .env.local et renseignez vos clés

# URL du projet (Settings > API > Project URL)
VITE_SUPABASE_URL=https://votre-projet.supabase.co

# Clé publique "anon" (Settings > API > anon public) — sûre côté client grâce aux RLS
VITE_SUPABASE_ANON_KEY=votre-cle-anon

# --- Tests e2e (Playwright) — Supabase local uniquement, jamais de clé production ---
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_SERVICE_KEY=votre-cle-service-locale
